generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
  REJECTED
}

enum ExamType {
  QUIZ
  MIDTERM
  FINAL
  ASSIGNMENT
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum DeliveryMode {
  ONLINE
  PAPER
}

enum QuestionType {
  MCQ
  FITB
  SHORT_ANSWER
}

enum ProfileStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum SemesterType {
  FALL
  SPRING
  SUMMER
}

enum SemesterStatus {
  UPCOMING
  REGISTRATION_OPEN
  IN_PROGRESS
  GRADING
  COMPLETED
}

enum GradeLetter {
  A_PLUS  // A+ >= 90
  A       // A >= 85
  A_MINUS // A- >= 80
  B_PLUS  // B+ >= 75
  B       // B >= 70
  B_MINUS // B- >= 65
  C_PLUS  // C+ >= 60
  C       // C >= 50
  C_MINUS // C- >= 45
  D       // D >= 40
  F       // F < 40
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  fullName        String
  phone           String?
  role            Role     @default(STUDENT)
  profileImage    String?  // Base64 encoded profile image
  isProfileComplete Boolean @default(false) // Student has completed profile
  isApproved      Boolean  @default(false) // Account approved by admin
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  classStudents   ClassStudent[]
  classTeachers   ClassTeacher[]
  courseClasses   CourseClass[]   @relation("CourseClassTeacher")
  attempts        Attempt[]
  materials       Material[]
  liveSessions    LiveSession[]
  manualGrades    ManualGrade[]
  attendance      Attendance[]
  faceVerifications FaceVerification[]
  videoFaceVerifications VideoFaceVerification[]
  studentProfile  StudentProfile?
  courseSections  CourseSection[]  @relation("CourseSectionTeacher")
  enrollments     StudentEnrollment[]
  earlyExamRequests EarlyExamRequest[]
  addDropRequests AddDropRequest[]  @relation("AddDropStudent")
  reviewedAddDrop AddDropRequest[] @relation("AddDropReviewer")
  notifications   Notification[]
  auditLogs       AuditLog[]
  questionReports QuestionReport[]  @relation("StudentReports")
  reviewedReports QuestionReport[]  @relation("ReviewerReports")
  liveSessionAttendance LiveSessionAttendance[]
  manualAttendanceRecords ManualAttendanceRecord[]
  manualAttendanceSessions ManualAttendanceSession[]
  materialViews MaterialView[]
  readingProgress MaterialReadingProgress[]
  semesterPayments SemesterPayment[] @relation("StudentPayments")
  certificates    Certificate[] @relation("StudentCertificates")
}

model StudentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  status    ProfileStatus @default(DRAFT)
  adminReviewedBy String?
  reviewedAt DateTime?
  rejectionReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])

  // === Personal - Basic Information ===
  firstName           String?
  fatherName          String?
  grandFatherName     String?
  firstNameLocal      String?  // Amharic
  fatherNameLocal     String?  // Amharic
  grandFatherNameLocal String? // Amharic
  dateOfBirthGC       DateTime?
  gender              String?  // MALE, FEMALE, OTHER
  placeOfBirth        String?
  motherTongue        String?
  healthStatus        String?  // Normal, etc.
  maritalStatus       String?  // Single, Married, etc.
  nationalIdFan       String?

  // === Personal - Location and Address ===
  citizenship         String?
  country             String?
  city                String?
  subCity             String?
  kebele              String?
  woreda              String?
  houseNumber         String?
  phone               String?
  email               String?
  pobox               String?

  // === Personal - Others ===
  economicalStatus    String?  // Low, Medium, High
  areaType            String?  // Pastoral, Non Pastoral
  tinNumber           String?
  accountNumber       String?

  // === Educational - Campus Related ===
  stream              String?  // Natural Science, Social Science
  entryYear           Int?
  sponsorCategory     String?  // Govt, Private, etc.
  sponsoredBy         String?
  nationalExamYearEC  Int?
  examinationId       String?
  admissionDate       DateTime?
  checkedInDate        DateTime?
  nationalExamResultTotal Int?

  // === Educational - National Exam Results (Natural Science) ===
  examEnglish         Int?
  examPhysics         Int?
  examCivics          Int?
  examNaturalMath     Int?
  examChemistry       Int?
  examBiology         Int?
  examAptitude        Int?

  // === Educational - National Exam Results (Social Science) ===
  examHistory         Int?
  examEconomics       Int?
  examGeography       Int?
  examSocialMath      Int?

  // === Documents ===
  documents           StudentDocument[]
}

model StudentDocument {
  id              String   @id @default(cuid())
  studentProfileId String
  documentType    String   // Elementary Completion, High School Transcripts, etc.
  fileName        String?
  fileUrl         String?  // Base64 or file path
  status          String   @default("NOT_SUBMITTED") // SUBMITTED, NOT_SUBMITTED
  uploadedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
}

model Department {
  id                    String   @id @default(cuid())
  name                  String   @unique  // e.g., "Computer Science", "Information Technology"
  code                  String   @unique  // e.g., "CS", "IT"
  description           String?
  pricePerCreditHour    Float              // Fee per credit hour in ETB
  totalCreditHours      Int                // Total credit hours required for the program
  minCreditHoursToGraduate Int            // Minimum credit hours needed to graduate
  minGradeToGraduate    Float    @default(2.0) // Minimum CGPA required to graduate (e.g., 2.0)
  durationYears         Int      @default(4) // Duration of the program in years
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  classes    Class[]
  certificates Certificate[]
}

model Class {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  year          Int?
  section       String?
  departmentId  String?             // Reference to Department
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  department    Department? @relation(fields: [departmentId], references: [id])
  students       ClassStudent[]
  teachers       ClassTeacher[]
  courses        CourseClass[]
  courseSections CourseSection[]
  liveSessions   LiveSession[]
  manualAttendanceSessions ManualAttendanceSession[]
}

model ClassStudent {
  id        String   @id @default(cuid())
  classId   String
  studentId String
  createdAt DateTime @default(now())

  class   Class @relation(fields: [classId], references: [id])
  student User  @relation(fields: [studentId], references: [id])

  @@unique([classId, studentId])
}

model ClassTeacher {
  id        String   @id @default(cuid())
  classId   String
  teacherId String
  createdAt DateTime @default(now())

  class   Class @relation(fields: [classId], references: [id])
  teacher User  @relation(fields: [teacherId], references: [id])

  @@unique([classId, teacherId])
}

model CourseClass {
  id        String   @id @default(cuid())
  courseId  String
  classId   String
  teacherId String?
  createdAt DateTime @default(now())

  course   Course @relation(fields: [courseId], references: [id])
  class    Class  @relation(fields: [classId], references: [id])
  teacher  User?  @relation("CourseClassTeacher", fields: [teacherId], references: [id])

  @@unique([courseId, classId])
}

model Course {
  id           String   @id @default(cuid())
  title        String
  code         String   @unique
  description  String?
  stream       String?  // Natural Science, Social Science, or null for common courses
  creditHours  Int      @default(3) // US Credit hours for the course
  ectsCredits  Int      @default(5) // European Credit Transfer System (ECTS) credits
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  courseClasses CourseClass[]
  courseSections CourseSection[]
  assessments   Assessment[]
  materials     Material[]
  liveSessions  LiveSession[]
  gradeConfig   CourseGradeConfig?
  gradeComponents GradeComponent[]
  addDropRequests AddDropRequest[]
  attendance    Attendance[]
  manualAttendanceSessions ManualAttendanceSession[]
}

model Material {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  content     String?   // For text-based materials
  fileUrl     String?   // For uploaded files (URL or base64)
  fileType    String?   // e.g., "pdf", "doc", "ppt", "link"
  fileName    String?   // Original file name
  previewFileUrl String? // PDF version for inline preview (converted from PPT/DOC/XLS)
  htmlContent    String?  // HTML version for PPTX files with reading time tracking
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id])
  author User   @relation(fields: [createdBy], references: [id])
  views   MaterialView[]
  readingProgress MaterialReadingProgress[]
  videoFaceVerifications VideoFaceVerification[]
}

model MaterialView {
  id          String   @id @default(cuid())
  materialId  String
  studentId   String
  openedAt    DateTime @default(now())
  closedAt    DateTime?
  durationSec Int?     // seconds viewed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  student  User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([materialId, studentId, openedAt])
}

// Reading progress for PPTX/HTML materials with slide-by-slide tracking
model MaterialReadingProgress {
  id             String   @id @default(cuid())
  materialId     String
  studentId      String
  totalTime      Int      @default(0)     // Total time spent in seconds
  completedSlides Int     @default(0)     // Number of slides marked as read
  totalSlides    Int      @default(0)     // Total number of slides
  slideStatuses  Json?                   // JSON object {slideNum: status}
  slideTimeSpent Json?                    // JSON object {slideNum: seconds}
  isCompleted    Boolean  @default(false)  // All slides read
  lastReadAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  student  User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([materialId, studentId])
  @@index([studentId, isCompleted])
}

model LiveSession {
  id          String   @id @default(cuid())
  courseId    String
  classId     String
  teacherId   String
  title       String
  description String?
  scheduledAt DateTime
  duration    Int      // in minutes
  status      String   @default("SCHEDULED") // SCHEDULED, LIVE, ENDED
  meetingUrl  String   // Jitsi meeting room URL
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course     Course                 @relation(fields: [courseId], references: [id])
  class      Class                  @relation(fields: [classId], references: [id])
  teacher    User                   @relation(fields: [teacherId], references: [id])
  attendance LiveSessionAttendance[]
}

model LiveSessionAttendance {
  id          String   @id @default(cuid())
  sessionId   String
  studentId   String
  joinedAt    DateTime
  leftAt      DateTime?
  duration    Int?     // minutes attended
  faceAlerts  Int      @default(0) // number of face-not-detected alerts
  status      String   @default("JOINED") // JOINED, LEFT, ATTENDED, PARTIAL, ABSENT
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
}

model ManualAttendanceSession {
  id          String   @id @default(cuid())
  courseId    String
  classId     String
  teacherId   String
  title       String   @default("Face-to-Face Class")
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course   Course                     @relation(fields: [courseId], references: [id])
  class    Class                      @relation(fields: [classId], references: [id])
  teacher  User                       @relation(fields: [teacherId], references: [id])
  records  ManualAttendanceRecord[]

  @@unique([courseId, classId, date])
}

model ManualAttendanceRecord {
  id          String   @id @default(cuid())
  sessionId   String
  studentId   String
  status      String   @default("PRESENT") // PRESENT, ABSENT, LATE, EXCUSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session ManualAttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User                    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
}

model Assessment {
  id             String       @id @default(cuid())
  courseId       String
  title          String
  description    String?
  examType       ExamType     @default(QUIZ)
  deliveryMode   DeliveryMode @default(ONLINE)
  timeLimit      Int?
  maxScore       Int          @default(100) // Maximum score for this assessment
  componentId    String?      // Link to grade component (auto-sets maxScore from weight)
  isOpen         Boolean      @default(false) // Teacher must open for students to take
  scheduledStart DateTime?    // When the assessment is scheduled to open
  scheduledEnd   DateTime?    // When the assessment is scheduled to close
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  course       Course        @relation(fields: [courseId], references: [id])
  component    GradeComponent? @relation(fields: [componentId], references: [id])
  questions    Question[]
  attempts     Attempt[]
  manualGrades ManualGrade[]
}

// Grade components - dynamic categories with weights (quiz, assignment, class activity, etc.)
model GradeComponent {
  id        String   @id @default(cuid())
  courseId  String
  name      String   // e.g., "Quiz", "Assignment", "Class Activity", "Midterm", "Final"
  weight    Int      // percentage weight (e.g., 15 means 15%)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course      Course       @relation(fields: [courseId], references: [id])
  assessments Assessment[]

  @@unique([courseId, name])
}

model Question {
  id           String       @id @default(cuid())
  assessmentId String
  type         QuestionType @default(MCQ)
  prompt       String
  // MCQ fields
  optionA      String?
  optionB      String?
  optionC      String?
  optionD      String?
  correct      String?      // For MCQ: A, B, C, or D
  // FITB field
  correctAnswer String?    // For fill-in-the-blank
  // Short answer field
  modelAnswer  String?      // For teacher reference during grading
  points       Int          @default(1)
  createdAt    DateTime     @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id])
  answers    Answer[]
  reports    QuestionReport[]
}

// Student reports for mistaken/incorrect questions
model QuestionReport {
  id          String           @id @default(cuid())
  questionId  String
  studentId   String
  reason      String           // Why the student thinks the question is wrong
  status      ReportStatus     @default(PENDING)
  adminNotes  String?          // Admin response/notes
  reviewedBy  String?          // Admin who reviewed
  reviewedAt  DateTime?
  createdAt   DateTime         @default(now())

  question    Question         @relation(fields: [questionId], references: [id])
  student     User             @relation("StudentReports", fields: [studentId], references: [id])
  reviewer    User?            @relation("ReviewerReports", fields: [reviewedBy], references: [id])

  @@unique([questionId, studentId]) // One report per question per student
  @@index([status])
}

model Attempt {
  id               String        @id @default(cuid())
  assessmentId     String
  studentId        String
  status           AttemptStatus @default(IN_PROGRESS)
  score            Int?
  startedAt        DateTime      @default(now())
  submittedAt      DateTime?
  pausedAt         DateTime?               // When the exam was paused (disconnect)
  remainingSeconds Int?                    // Seconds remaining when paused
  currentQuestionIdx Int?     @default(0)  // Last question index the student was on
  faceVerified     Boolean       @default(false) // Face matched during exam
  faceVerifiedAt   DateTime?     // When admin approved face match

  assessment Assessment @relation(fields: [assessmentId], references: [id])
  student    User       @relation(fields: [studentId], references: [id])
  answers    Answer[]
  faceVerification FaceVerification?

  @@unique([assessmentId, studentId, startedAt])
}

// Face verification record for admin review when face doesn't match
model FaceVerification {
  id              String   @id @default(cuid())
  attemptId       String   @unique
  studentId       String
  capturedImage   String   // Base64 encoded image captured during exam
  matchedImage    String?  // Reference to stored profile image
  matchResult     Boolean  // False = face didn't match, needs admin review
  adminReviewed   Boolean  @default(false)
  adminApproved   Boolean  @default(false) // Admin approved the face match
  adminId         String?  // Admin who reviewed
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())

  attempt Attempt @relation(fields: [attemptId], references: [id])
  student User   @relation(fields: [studentId], references: [id])
}

// Face verification for video watching (tracked by teacher-uploaded videos)
model VideoFaceVerification {
  id              String   @id @default(cuid())
  materialId      String   // The video material being watched
  studentId       String
  capturedImage   String   // Base64 encoded image captured during video
  matchedImage    String?  // Reference to stored profile image
  matchResult     Boolean  // False = face didn't match, needs admin review
  adminReviewed   Boolean  @default(false)
  adminApproved   Boolean  @default(false)
  adminId         String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id])
  student  User     @relation(fields: [studentId], references: [id])

  @@unique([materialId, studentId])
}

model Answer {
  id         String   @id @default(cuid())
  attemptId  String
  questionId String
  selected   String?   // For MCQ: A, B, C, or D
  textAnswer String?   // For FITB and SHORT_ANSWER
  isCorrect  Boolean?  // Auto-grading result
  score      Int?      // For teacher-graded questions
  feedback   String?   // Teacher feedback
  createdAt  DateTime  @default(now())

  attempt  Attempt  @relation(fields: [attemptId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
}

// Manual grades entered by teacher (for non-online assessments like participation, projects, etc.)
model ManualGrade {
  id           String   @id @default(cuid())
  assessmentId String
  studentId    String
  score        Int      // Score out of maxScore
  feedback     String?  // Teacher feedback
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id])
  student    User       @relation(fields: [studentId], references: [id])

  @@unique([assessmentId, studentId])
}

// Grade configuration for a course (weights for each component)
model CourseGradeConfig {
  id             String   @id @default(cuid())
  courseId       String   @unique
  quizWeight     Int      @default(25)    // % weight for quizzes
  midtermWeight  Int      @default(25)    // % weight for midterm
  finalWeight    Int      @default(40)    // % weight for final
  attendanceWeight Int    @default(10)    // % weight for attendance
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id])
}

// Attendance marks entered by teacher
model Attendance {
  id           String   @id @default(cuid())
  courseId     String
  studentId    String
  score        Int      // Score out of 100 for attendance
  feedback     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course   Course @relation(fields: [courseId], references: [id])
  student  User   @relation(fields: [studentId], references: [id])

  @@unique([courseId, studentId])
}

// === Academic Management Models ===

// Academic Year (e.g., "2024-2025")
model AcademicYear {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "2024-2025"
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  semesters   Semester[]
}

// Semester within an academic year
model Semester {
  id              String        @id @default(cuid())
  academicYearId  String
  type            SemesterType  // FALL, SPRING, SUMMER
  name            String        // e.g., "Fall 2024"
  startDate       DateTime
  endDate         DateTime
  registrationStart DateTime?
  registrationEnd   DateTime?
  // Add/Drop period
  addDropStart     DateTime?    // Start of add/drop period
  addDropEnd       DateTime?    // End of add/drop period
  // Official exam dates set by admin
  midtermExamDate   DateTime?   // Official midterm exam date (legacy)
  finalExamDate     DateTime?   // Official final exam date (legacy)
  midtermExamStart  DateTime?   // Start of midterm exam period
  midtermExamEnd    DateTime?   // End of midterm exam period
  finalExamStart    DateTime?   // Start of final exam period
  finalExamEnd      DateTime?   // End of final exam period
  examPeriodStart   DateTime?
  examPeriodEnd     DateTime?
  gradingDeadline   DateTime?
  status          SemesterStatus @default(UPCOMING)
  isCurrent       Boolean       @default(false)
  registrationFee Float?        // Fee required for semester registration (ETB)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  academicYear    AcademicYear  @relation(fields: [academicYearId], references: [id])
  courseSections  CourseSection[]
  addDropRequests AddDropRequest[]
  payments       SemesterPayment[]

  @@unique([academicYearId, type])
}

// Course offered in a specific semester (Course Section)
model CourseSection {
  id           String       @id @default(cuid())
  courseId     String
  semesterId   String
  teacherId    String
  classId      String?      // Optional: assign to a class (group of students)
  sectionCode  String       // e.g., "CS101-A" (course code + section)
  deliveryMode DeliveryMode @default(ONLINE)
  schedule     String?      // e.g., "Mon/Wed 9:00-10:30"
  room         String?      // e.g., "Room 101"
  maxCapacity  Int?
  isPublished  Boolean      @default(false) // Visible to students for registration
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  course      Course   @relation(fields: [courseId], references: [id])
  semester    Semester @relation(fields: [semesterId], references: [id])
  teacher     User     @relation("CourseSectionTeacher", fields: [teacherId], references: [id])
  class       Class?   @relation(fields: [classId], references: [id])
  enrollments StudentEnrollment[]
  examSchedules ExamSchedule[]
  addDropRequests AddDropRequest[]

  @@unique([courseId, semesterId, sectionCode])
  scheduleSlots CourseScheduleSlot[]
}

// Weekly schedule slots for a course section
model CourseScheduleSlot {
  id              String    @id @default(cuid())
  courseSectionId String
  dayOfWeek       DayOfWeek // MONDAY, TUESDAY, etc.
  startTime       String    // "14:30" (24-hour format)
  endTime         String    // "16:30" (24-hour format)
  room            String?   // "XI-8", "HW Lab" - null for online
  isOnline        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  courseSection   CourseSection @relation(fields: [courseSectionId], references: [id], onDelete: Cascade)

  @@unique([courseSectionId, dayOfWeek, startTime])
}

// Student enrollment in a course section
model StudentEnrollment {
  id              String   @id @default(cuid())
  courseSectionId String
  studentId       String
  enrolledAt      DateTime @default(now())
  status          String   @default("ENROLLED") // ENROLLED, DROPPED, WITHDRAWN

  courseSection   CourseSection @relation(fields: [courseSectionId], references: [id])
  student         User          @relation(fields: [studentId], references: [id])
  grade           StudentGrade?
  dropRequests    AddDropRequest[]

  @@unique([courseSectionId, studentId])
}

// Student's grade for a course section
model StudentGrade {
  id              String     @id @default(cuid())
  enrollmentId    String     @unique
  quizScore       Float?     // Weighted mark out of quiz weight
  assignmentScore Float?     // Weighted mark out of assignment weight
  midtermScore    Float?     // Weighted mark out of midterm weight
  finalScore      Float?     // Weighted mark out of final weight
  attendanceScore Float?     // Weighted mark out of attendance weight
  totalScore      Float?     // Calculated total out of 100
  gradeLetter     GradeLetter?
  gradePoint      Float?     // 4.0, 3.75, 3.5, etc.
  isSubmitted     Boolean    @default(false) // Teacher has submitted final grade
  isPublished     Boolean    @default(false) // Admin has published grades
  submittedAt     DateTime?
  publishedAt     DateTime?
  feedback        String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  enrollment      StudentEnrollment @relation(fields: [enrollmentId], references: [id])
}

// Exam Schedule for a course section (Midterm, Final)
// Teacher proposes early exam date; if all students agree, exam can be early
model ExamSchedule {
  id              String   @id @default(cuid())
  courseSectionId String
  examType        ExamType // MIDTERM, FINAL
  // Official date from semester (set by admin)
  officialDate    DateTime?
  // Teacher's proposed early date (if they want to move it earlier)
  proposedDate    DateTime?
  duration        Int      // Duration in minutes
  location        String?  // Exam room/location
  isOnline        Boolean  @default(false) // Online exam or physical
  instructions    String?
  weight          Int      @default(30) // Weight percentage for grade calculation
  // Early exam proposal status
  earlyExamStatus String?  @default("NONE") // NONE, PROPOSED, ALL_AGREED, APPROVED, REJECTED
  proposalDeadline DateTime? // Deadline for students to respond to early exam proposal
  // Final confirmed date (either proposed or official)
  confirmedDate   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  courseSection   CourseSection @relation(fields: [courseSectionId], references: [id])
  earlyRequests   EarlyExamRequest[]

  @@unique([courseSectionId, examType])
}

// Early Exam Request - Students agree/disagree to take exam early
model EarlyExamRequest {
  id             String   @id @default(cuid())
  examScheduleId String
  studentId      String
  agreed         Boolean  @default(false) // true = agreed to early, false = wants official date
  respondedAt    DateTime? // When student responded
  createdAt      DateTime @default(now())

  examSchedule   ExamSchedule @relation(fields: [examScheduleId], references: [id])
  student        User        @relation(fields: [studentId], references: [id])

  @@unique([examScheduleId, studentId])
}

// Notifications for users
model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String   // REGISTRATION_OPEN, GRADE_PUBLISHED, etc.
  title       String
  message     String
  data        Json?    // Additional data (semesterId, courseId, etc.)
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// Add/Drop Request for courses
model AddDropRequest {
  id              String          @id @default(cuid())
  studentId       String
  semesterId      String
  type            AddDropType     // ADD, DROP
  courseSectionId String?         // For ADD: target section to enroll in
  dropEnrollmentId String?        // For DROP: enrollment to drop
  courseId        String          // Course being added or dropped
  reason          String?         // Student's reason for request
  status          AddDropStatus   @default(PENDING)
  adminReviewedBy String?
  reviewedAt      DateTime?
  adminNotes      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  student         User            @relation("AddDropStudent", fields: [studentId], references: [id])
  semester        Semester        @relation(fields: [semesterId], references: [id])
  courseSection   CourseSection?  @relation(fields: [courseSectionId], references: [id])
  dropEnrollment  StudentEnrollment? @relation(fields: [dropEnrollmentId], references: [id])
  course          Course          @relation(fields: [courseId], references: [id])
  reviewedBy      User?           @relation("AddDropReviewer", fields: [adminReviewedBy], references: [id])

  @@index([studentId, semesterId])
  @@index([semesterId, status])
}

enum AddDropType {
  ADD
  DROP
}

enum AddDropStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED_CORRECT   // Question was indeed wrong
  RESOLVED_INCORRECT // Report was invalid
  DISMISSED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model SemesterPayment {
  id              String       @id @default(cuid())
  studentId       String
  semesterId      String
  amount          Float
  currency        String       @default("ETB")
  txRef           String       @unique  // Chapa transaction reference
  chapaRefId      String?               // Chapa reference ID (returned after payment)
  status          PaymentStatus @default(PENDING)
  checkoutUrl     String?              // Chapa checkout URL
  returnUrl       String?              // URL to redirect after payment
  paidAt          DateTime?            // When payment was completed
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  student         User         @relation("StudentPayments", fields: [studentId], references: [id])
  semester        Semester     @relation(fields: [semesterId], references: [id])

  @@index([studentId, semesterId])
  @@index([txRef])
}

model Certificate {
  id                String   @id @default(cuid())
  studentId         String
  departmentId      String
  certificateNumber String   @unique  // Auto-generated cert number
  cgpa              Float              // Cumulative Grade Point Average
  totalCreditHours  Int                // Total credit hours completed
  issuedAt          DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  student           User         @relation("StudentCertificates", fields: [studentId], references: [id])
  department        Department   @relation(fields: [departmentId], references: [id])

  @@index([studentId, departmentId])
}

// Audit Log for tracking system activity
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?  // User who performed the action (null for system)
  userRole    String?  // Role of the user at time of action
  action      String   // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, ENROLL, GRADE_SUBMIT, etc.
  category    String   // AUTH, USER, COURSE, ENROLLMENT, GRADE, SEMESTER, CLASS, etc.
  targetId    String?  // ID of the affected entity
  targetType  String?  // Model name: User, Course, Enrollment, etc.
  description String   // Human-readable description
  ipAddress   String?  // Request IP address
  metadata    Json?    // Additional context (old values, new values, etc.)
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([category])
  @@index([createdAt])
}

